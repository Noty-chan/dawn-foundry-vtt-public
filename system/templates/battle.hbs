{{#*inline "battleRow"}}<div class="dawn-battle-row {{#if current}}current{{/if}} {{#if unavailable}}unavailable{{/if}}"><img src="{{img}}" alt=""><button type="button" data-action="openActor" data-combatant-id="{{id}}">{{name}}</button><span>{{#if current}}{{dawnLabel 'battleCurrentShort'}}{{else}}{{#if acted}}{{dawnLabel 'battleActed'}}{{/if}}{{/if}}{{#if disappeared}} · {{dawnLabel 'battleDisappeared'}}{{/if}}{{#if unavailable}} · {{dawnLabel 'battleUnavailable'}}{{/if}}</span>{{#if hasAP}}<strong>{{dawnLabel 'ap'}} {{ap}}</strong>{{/if}}</div>{{/inline}}
<section class="dawn-sheet dawn-battle-content">
  <div class="dawn-kicker">DAWN · LIONWING</div><h2>{{dawnLabel 'battleTitle'}}</h2>
  {{#if executorHint}}<p class="dawn-muted">{{dawnLabel 'battleExecutorHint'}}</p>{{/if}}
  {{#if hasCombat}}
    <div class="dawn-statline"><div>{{dawnLabel 'battleRound'}} <strong>{{round}}</strong></div>{{#if hasTension}}<div>{{dawnLabel 'tension'}} <strong>{{tension}}</strong></div>{{/if}}<div>{{dawnLabel 'battleCurrent'}} <strong>{{#if currentName}}{{currentName}}{{else}}—{{/if}}</strong></div></div>
    {{#if executor}}{{#if started}}{{#if hasTension}}<div class="dawn-form-row"><label>{{dawnLabel 'tensionCorrection'}} <input type="number" min="0" value="{{tension}}" data-battle-tension aria-label="{{dawnLabel 'tensionCorrection'}}"></label><button type="button" data-action="tension" {{#if busy}}disabled{{/if}}>{{dawnLabel 'tensionSave'}}</button></div>{{/if}}{{/if}}{{/if}}
    {{#if executor}}{{#if turnMismatch}}<p>{{dawnLabel 'battleTurnMismatch'}}</p>{{#if executor}}<button type="button" data-action="reconcile">{{dawnLabel 'battleReconcileButton'}}</button>{{/if}}{{/if}}{{#if recovery}}<p>{{dawnLabel 'battleTransitionPending'}}</p><button type="button" data-action="recover" {{#if busy}}disabled{{/if}}>{{dawnLabel 'battleRecoveryButton'}}</button>{{else}}<div class="dawn-battle-control"><label>{{#if started}}{{dawnLabel 'battleNext'}}{{else}}{{dawnLabel 'firstTurn'}}{{/if}}<select data-battle-choice {{#unless hasCandidates}}disabled{{/unless}}>{{#each candidates}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><button type="button" class="dawn-primary" data-action="advance" {{#unless hasCandidates}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>{{#if started}}{{dawnLabel 'battleAdvance'}}{{else}}{{dawnLabel 'battleStart'}}{{/if}}</button>{{#unless turnMismatch}}<button type="button" data-action="setup" {{#if busy}}disabled{{/if}}>{{dawnLabel 'battleAddSelected'}}</button>{{/unless}}{{#if newRound}}<small>{{dawnLabel 'battleNewRound'}}</small>{{/if}}</div>{{/if}}{{/if}}
    {{#if fodderReminder}}<p class="dawn-muted dawn-fodder-reminder">{{dawnLabel fodderReminder}}</p>{{/if}}
    <h3>{{dawnLabel 'battleHeroes'}}</h3><div class="dawn-battle-list">{{#each heroes}}{{> battleRow}}{{else}}<p class="dawn-muted">{{dawnLabel 'noEntries'}}</p>{{/each}}</div>
    <h3>{{dawnLabel 'battleEnemies'}}</h3><div class="dawn-battle-list">{{#each enemies}}{{> battleRow}}{{else}}<p class="dawn-muted">{{dawnLabel 'noEntries'}}</p>{{/each}}</div>
    <p class="dawn-muted">{{dawnLabel 'battleHint'}}</p>
  {{else}}<p>{{dawnLabel 'battleNoCombat'}}</p>{{#if executor}}<button type="button" data-action="setup" {{#if busy}}disabled{{/if}}>{{dawnLabel 'battleCreateSelected'}}</button>{{/if}}{{/if}}
</section>
