<section class="dawn-hero-layout">
<header class="dawn-hero-header"><img class="dawn-header-portrait" src="{{portraitSrc}}" alt="{{name}}" {{#if editing}}data-action="art"{{/if}}><div class="dawn-identity"><div class="dawn-kicker">DAWN · LIONWING</div>{{#if editing}}<input class="dawn-name" name="name" value="{{actor.name}}" aria-label="{{dawnLabel 'name'}}">{{else}}<h1>{{name}}</h1>{{/if}}<div class="dawn-subtitle">{{dawnLabel 'tier'}} {{system.tier}}{{#if primaryArchetype}} · {{primaryArchetype}}{{/if}}{{#if outlook}} · {{outlook}}{{/if}} · {{statusLabel}}</div></div></header>
<nav class="dawn-side-tabs" aria-label="{{dawnLabel 'sheetSections'}}">{{#each tabs}}<button type="button" data-action="sheetTab" data-tab="{{id}}" aria-label="{{label}}" title="{{label}}" aria-pressed="{{active}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{shortLabel}}</span></button>{{/each}}</nav>
<div class="dawn-hero-main">
{{#if showOverview}}{{#if isDraft}}<div class="dawn-creation-banner"><div><strong>{{dawnLabel 'draft'}}</strong><p>{{dawnLabel 'creationProgressHint'}}</p></div><button type="button" class="dawn-primary" data-action="creation">{{dawnLabel 'createCharacter'}}</button></div>{{/if}}<div class="dawn-overview-columns"><section class="dawn-portrait-card"><div class="dawn-portrait-switch"><button type="button" data-action="portraitMode" data-mode="art" aria-pressed="{{artPortrait}}">{{dawnLabel 'characterArt'}}</button><button type="button" data-action="portraitMode" data-mode="token" aria-pressed="{{tokenPortrait}}">{{dawnLabel 'token'}}</button></div><img class="{{#if tokenPortrait}}token-art{{/if}}" src="{{portraitSrc}}" alt="{{#if tokenPortrait}}{{tokenTarget}}{{else}}{{dawnLabel 'characterArt'}}{{/if}}" {{#if editing}}data-action="art"{{/if}}><p class="dawn-muted">{{#if tokenPortrait}}{{tokenTarget}}{{else}}{{dawnLabel 'characterArt'}}{{/if}}{{#if editing}} · {{dawnLabel 'clickToChooseArt'}}{{/if}}</p></section>
<section><h2>{{dawnLabel 'overview'}}</h2><div class="dawn-overview-attributes">{{#each attributes}}<label><span>{{label}}</span>{{#if ../editing}}<input name="system.attributes.{{key}}" type="number" min="0" value="{{value}}">{{else}}<strong>{{value}}</strong>{{/if}}</label>{{/each}}</div>{{#if system.speedEffectConflict}}<p class="dawn-context-hint">{{dawnLabel 'speedEffectConflict'}}</p>{{/if}}<div class="dawn-derived-grid"><div><span>{{dawnLabel 'health'}}</span><strong>{{system.health.value}} / {{system.health.max}}</strong></div><div><span>{{dawnLabel 'speed'}}</span><strong>{{system.speed}} {{dawnLabel 'cells'}}</strong></div><div><span>{{dawnLabel 'startingFocus'}}</span><strong>{{system.startingFocus}}</strong></div><div><span>{{dawnLabel 'armor'}}</span><strong>{{system.armor}}</strong></div></div><h3>{{dawnLabel 'description'}}</h3>{{#if editing}}<textarea name="system.biography" rows="5" aria-label="{{dawnLabel 'description'}}">{{system.biography}}</textarea>{{else}}<p class="dawn-pre dawn-biography">{{#if system.biography}}{{system.biography}}{{else}}{{dawnLabel 'emptyDescription'}}{{/if}}</p>{{/if}}</section></div>
<section class="dawn-progression-card"><div class="dawn-section-title"><div><h2>{{dawnLabel 'advancement'}}</h2><span class="dawn-muted">{{dawnLabel 'tier'}} {{system.tier}} · {{dawnLabel 'experience'}} {{system.progression.experience}}</span></div><button type="button" data-action="advancement" {{#unless editing}}disabled{{/unless}}>{{dawnLabel 'configureAdvancement'}}</button></div>{{#if showAdvancement}}<p class="dawn-muted">{{dawnLabel 'advancementHint'}}</p><div class="dawn-form-row"><label>{{dawnLabel 'tier'}}<input name="system.tier" type="number" min="1" max="6" value="{{system.tier}}" {{#unless editing}}disabled{{/unless}}></label><label>{{dawnLabel 'experience'}}<input name="system.progression.experience" type="number" min="0" value="{{system.progression.experience}}" {{#unless editing}}disabled{{/unless}}></label></div><p class="dawn-pre dawn-muted">{{dawnLabel 'advancementRules'}}</p>{{#if isReady}}<div class="dawn-budget-strip"><span>{{dawnLabel 'unspentRanks'}} <b>{{development.ranks}}</b></span><span>{{dawnLabel 'boon'}} <b>{{development.boons}}</b></span><span>{{dawnLabel 'techniqueLevels'}} <b>{{development.techniques}}</b></span></div><button type="button" class="dawn-primary" data-action="tierUp" {{#unless editing}}disabled{{/unless}}>{{dawnLabel 'increaseTier'}}</button>{{/if}}{{else}}{{#unless editing}}<p class="dawn-muted">{{dawnLabel 'unlockToChange'}}</p>{{/unless}}{{/if}}</section>{{/if}}
{{#if showFree}}<h2>{{dawnLabel 'unstructuredPlay'}}</h2>{{#if editable}}<button type="button" data-action="clocks"><i class="fa-solid fa-clock"></i> {{dawnLabel 'personalClocks'}}</button>{{/if}}<p class="dawn-context-hint">{{dawnLabel 'freeContextHint'}}</p>
<div class="dawn-roll-selection-summary"><div class="dawn-source-chips">{{#each selectedSources}}<span>{{name}} <b>{{count}}</b></span>{{else}}<span>{{dawnLabel 'noSources'}}</span>{{/each}}</div><button type="button" class="dawn-primary" data-action="roll">{{dawnLabel 'roll'}} · {{pool}}d6</button></div>
<div class="dawn-attribute-choices dawn-free-attributes">{{#each attributes}}<button type="button" data-action="source" data-attribute="{{key}}" aria-pressed="{{selected}}"><span>{{label}}</span><strong>{{value}}</strong></button>{{/each}}</div>
<div class="dawn-free-columns">{{#each sourceGroups}}<section class="dawn-source-group {{#if ability}}dawn-ability-group{{/if}}"><div class="dawn-section-title"><h3>{{label}}</h3>{{#if editing}}<button type="button" data-action="addItem" data-type="{{type}}" aria-label="{{dawnLabel 'add'}} {{label}}">+</button>{{/if}}</div>{{#if hint}}<p class="dawn-muted">{{hint}}</p>{{/if}}{{#each items}}<div class="dawn-free-source draggable" data-item-id="{{id}}" draggable="true"><button type="button" data-action="source" data-item-id="{{id}}" class="dawn-source-selector" aria-label="{{dawnLabel 'selectSource'}} · {{name}}" aria-pressed="{{selected}}"><i class="fa-solid {{#if selected}}fa-check{{else}}fa-plus{{/if}}" aria-hidden="true"></i></button><details data-expand="source-{{id}}" {{#if ../ability}}open{{/if}}><summary><span>{{name}}</span><strong>{{rank}}</strong></summary>{{#if description}}<p class="dawn-pre">{{{dawnRich description}}}</p>{{/if}}{{#if editing}}<label class="dawn-source-description">{{dawnLabel 'description'}}<textarea data-item-field="system.overrides.description" rows="3">{{description}}</textarea></label>{{#if isSkill}}<label>{{dawnLabel 'skillAttribute'}}<select data-item-field="system.mechanics.attribute"><option value="">{{dawnLabel 'skillAttributeUnset'}}</option>{{selectOptions attributeOptions selected=skillAttribute}}</select></label>{{/if}}{{#if isBond}}<label>{{dawnLabel 'bondTarget'}}<select data-item-field="system.mechanics.actorUuid"><option value="">{{dawnLabel 'bondTargetManual'}}</option>{{#each bondTargetOptions}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p class="dawn-muted">{{dawnLabel 'bondTargetHint'}}</p>{{/if}}<div class="dawn-source-editor"><input data-item-field="name" value="{{name}}" aria-label="{{dawnLabel 'name'}}"><input data-item-field="system.rank" type="number" value="{{rank}}" min="1" max="3" aria-label="{{dawnLabel 'rank'}}"><button type="button" data-action="item" data-item-id="{{id}}" aria-label="{{dawnLabel 'edit'}} {{name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button type="button" data-action="archive" data-item-id="{{id}}" aria-label="{{dawnLabel 'removeFromSheet'}} {{name}}">×</button></div>{{/if}}</details></div>{{else}}<p class="dawn-empty">{{dawnLabel 'noEntries'}}</p>{{/each}}</section>{{/each}}
<section class="dawn-boons-group"><div class="dawn-section-title"><h3>{{dawnLabel 'outlookAndBoons'}}</h3><button type="button" data-action="catalog" data-filter="boon" aria-label="{{dawnLabel 'chooseBoons'}}"><i class="fa-solid fa-book-open" aria-hidden="true"></i></button></div>{{#if editing}}<label>{{dawnLabel 'primaryOutlook'}}<select name="system.primaryOutlook"><option value="">—</option>{{#each outlooks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{else}}<p class="dawn-muted">{{outlook}}</p>{{/if}}{{#each boons}}<details class="dawn-feature draggable" data-item-id="{{id}}" draggable="true"><summary>{{name}}</summary><p class="dawn-pre">{{{dawnRich description}}}</p>{{#if editing}}<button type="button" data-action="item" data-item-id="{{id}}">{{dawnLabel 'edit'}}</button><button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</details>{{else}}<p class="dawn-empty">{{dawnLabel 'noEntries'}}</p>{{/each}}</section></div>
<section class="dawn-boons-group"><div class="dawn-section-title"><h3>{{dawnLabel 'bondRules'}}</h3><button type="button" data-action="catalog" data-filter="bondRules"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{dawnLabel 'bondActionLibrary'}}</button></div><p class="dawn-muted">{{dawnLabel 'bondActionSheetHint'}}</p>{{#each bondRules}}<details class="dawn-feature draggable" data-item-id="{{id}}" data-expand="bond-rule-{{id}}" draggable="true"><summary>{{name}}</summary><p class="dawn-pre">{{{dawnRich description}}}</p><div class="dawn-buttons">{{#if isBondAction}}<button type="button" data-action="bondActionChat" data-item-id="{{id}}">{{dawnLabel 'bondActionUse'}}</button>{{/if}}<button type="button" data-action="item" data-item-id="{{id}}">{{dawnLabel 'openItem'}}</button>{{#if editing}}<button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</div></details>{{else}}<p class="dawn-empty">{{dawnLabel 'bondActionEmpty'}}</p>{{/each}}</section>
<section class="dawn-boons-group"><div class="dawn-section-title"><h3>{{dawnLabel 'inventory'}}</h3>{{#if editable}}<button type="button" data-action="addItem" data-type="equipment">+ {{dawnLabel 'add'}}</button>{{/if}}</div>{{#each inventory}}<details class="dawn-feature draggable" data-item-id="{{id}}" data-expand="inventory-{{id}}" draggable="true"><summary>{{name}} × {{quantity}}</summary>{{#if ../editable}}<label>{{dawnLabel 'name'}}<input data-item-field="name" value="{{name}}"></label><label>{{dawnLabel 'inventoryQuantity'}}<input data-item-field="system.mechanics.quantity" type="number" min="0" step="1" value="{{quantity}}"></label><label>{{dawnLabel 'notes'}}<textarea data-item-field="system.notes" rows="3">{{notes}}</textarea></label><button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{else}}<p class="dawn-pre">{{notes}}</p>{{/if}}</details>{{else}}<p class="dawn-empty">{{dawnLabel 'inventoryEmpty'}}</p>{{/each}}</section>
<div class="dawn-free-resources"><label>{{dawnLabel 'wounds'}}<input name="system.wounds.value" type="number" min="0" value="{{system.wounds.value}}"></label><label>{{dawnLabel 'stress'}}<input name="system.stress.value" type="number" min="0" value="{{system.stress.value}}"></label><button type="button" data-action="party">{{dawnLabel 'influence'}} · {{dawnLabel 'party'}}</button></div>{{/if}}
{{#if showCombat}}<h2>{{dawnLabel 'structuredPlay'}}</h2>{{#if isGM}}<button type="button" data-action="damage">{{dawnLabel 'damageTitle'}}</button>{{/if}}{{#if isGM}}{{#if damageLog}}<details class="dawn-settings-section"><summary>{{dawnLabel 'damageHistory'}}</summary>{{#each damageLog}}<p>{{id}} · {{kind}}: {{amount}} · {{dawnLabel 'health'}} {{health}} · {{dawnLabel 'evasion'}} {{evasion}}</p>{{/each}}</details>{{/if}}{{/if}}<div class="dawn-combat-resources"><label>{{dawnLabel 'health'}}<div><input name="system.health.value" type="number" min="0" value="{{system.health.value}}"><span>/ {{system.health.max}}</span></div></label><label>{{dawnLabel 'focus'}}<input name="system.focus.value" type="number" min="0" value="{{system.focus.value}}"></label><label>{{dawnLabel 'evasion'}}<input name="system.evasion.value" type="number" min="0" value="{{system.evasion.value}}"></label><label>{{dawnLabel 'wounds'}}<input name="system.wounds.value" type="number" min="0" value="{{system.wounds.value}}"></label></div>
{{#if system.speedEffectConflict}}<p class="dawn-context-hint">{{dawnLabel 'speedEffectConflict'}}</p>{{/if}}{{#if activeEffects}}<section class="dawn-settings-section"><h3>{{dawnLabel 'activeEffects'}}</h3>{{#each activeEffects}}<details><summary>{{name}} {{#if durationStale}}<small>{{dawnLabel 'effectDurationManualShort'}}</small>{{else}}{{#if manual}}<small>{{dawnLabel 'effectManualShort'}}</small>{{/if}}{{/if}}</summary>{{#if description}}<p class="dawn-pre">{{{dawnRich description}}}</p>{{/if}}{{#if durationStale}}<p class="dawn-muted">{{dawnLabel 'effectDurationStale'}}</p>{{/if}}{{#if canSetDuration}}<button type="button" data-action="effectDuration" data-effect-id="{{id}}" aria-pressed="{{autoDuration}}">{{#if durationStale}}{{dawnLabel 'effectDurationClearStale'}}{{else}}{{#if autoDuration}}{{dawnLabel 'effectDurationAuto'}}{{else}}{{dawnLabel 'effectDurationEnable'}}{{/if}}{{/if}}</button><p class="dawn-muted">{{dawnLabel 'effectDurationHint'}}</p>{{/if}}{{#if ../editable}}<button type="button" data-action="removeEffect" data-effect-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</details>{{/each}}</section>{{/if}}<div class="dawn-statline"><div>{{dawnLabel 'speed'}} <strong>{{system.speed}}</strong> {{dawnLabel 'cells'}}</div><div>{{dawnLabel 'armor'}} <strong>{{system.armor}}</strong></div>{{#if combatant}}<div>{{dawnLabel 'ap'}} {{#if isGM}}<input data-combat-ap type="number" min="0" value="{{ap}}" aria-label="{{dawnLabel 'apCorrection'}}">{{else}}<strong>{{ap}}</strong>{{/if}}</div>{{/if}}{{#if hasTension}}<div>{{dawnLabel 'tension'}} <strong>{{tension}}</strong></div>{{/if}}</div>
<div class="dawn-combat-roll-row"><div class="dawn-attribute-choices">{{#each attributes}}<button type="button" data-action="source" data-attribute="{{key}}" aria-pressed="{{selected}}"><span>{{label}}</span><strong>{{value}}</strong></button>{{/each}}</div><button type="button" class="dawn-primary" data-action="roll">{{dawnLabel 'combatRoll'}} · {{pool}}d6</button></div><p class="dawn-context-hint">{{dawnLabel 'combatContextHint'}}</p>
<details class="dawn-basic-actions" data-expand="basicActions"><summary>{{dawnLabel 'basicActions'}}</summary><div class="dawn-action-grid">{{#each basicActions}}<details><summary>{{name}} <small>{{cost.amount}} {{dawnLabel cost.resource}}</small></summary><p class="dawn-pre">{{{dawnRich description}}}</p>{{#if attackAttributes}}<small>{{dawnLabel 'heroAttackRollHint'}}</small>{{/if}}<div class="dawn-buttons">{{#if breathe}}<button type="button" data-action="basic" data-basic="breathe">{{dawnLabel 'applyBreathe'}}</button>{{/if}}{{#each attackAttributes}}<button type="button" data-action="heroAttackRoll" data-id="{{../id}}" data-attribute="{{id}}" title="{{dawnLabel 'heroAttackRollHint'}}"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i> {{name}}</button>{{/each}}<button type="button" data-action="actionChat" data-id="{{id}}" aria-label="{{dawnLabel 'showChat'}} · {{name}}"><i class="fa-regular fa-message" aria-hidden="true"></i></button></div></details>{{/each}}</div></details>
<div class="dawn-section-title"><h2>{{dawnLabel 'techniques'}} <span class="dawn-count">{{techniqueCount}} · {{techniqueRanks}} {{dawnLabel 'techniqueLevels'}}</span></h2><button type="button" data-action="catalog" data-filter="technique"><i class="fa-solid fa-book-open" aria-hidden="true"></i> {{dawnLabel 'chooseTechniques'}}</button></div>
{{#each techniqueGroups}}<section class="dawn-tech-group"><h3>{{name}}</h3>{{#each items}}<details {{#if open}}open{{/if}} class="dawn-tech-card draggable" data-item-id="{{id}}" draggable="true"><summary><span>{{name}} <small title="{{dawnLabel 'complexity'}}">{{complexity}}★</small></span>{{#if editing}}<span class="dawn-pips">{{#each levels}}<button type="button" data-action="level" data-item-id="{{../id}}" data-level="{{n}}" aria-label="{{dawnLabel 'learnLevel'}} {{n}} · {{../name}}" aria-pressed="{{learned}}">{{n}}</button>{{/each}}</span>{{else}}<small>{{dawnLabel 'level'}} {{level}} / 3</small>{{/if}}</summary><div class="dawn-tech-card-body"><p class="dawn-muted">{{tags}}</p>{{#each levels}}<details class="dawn-tech-level {{#unless learned}}unlearned{{/unless}}" {{#if learned}}open{{/if}}><summary><span>{{n}}. {{name}}</span>{{#unless learned}}<small>{{dawnLabel 'notLearned'}}</small>{{/unless}}</summary><p class="dawn-pre">{{{dawnRich text}}}</p>{{#if learned}}<div class="dawn-level-tools"><button type="button" data-action="techniqueChat" data-item-id="{{../id}}" data-level="{{n}}" aria-label="{{dawnLabel 'showChat'}} · {{name}}"><i class="fa-regular fa-message" aria-hidden="true"></i></button><button type="button" data-action="techniqueRoll" data-item-id="{{../id}}" data-level="{{n}}" aria-label="{{dawnLabel 'roll'}} · {{name}}"><i class="fa-solid fa-dice-d6" aria-hidden="true"></i></button></div>{{/if}}</details>{{/each}}<div class="dawn-tech-footer"><span>{{#if packLabel}}{{packLabel}}{{/if}}{{#if source.pdfPage}} PDF {{source.pdfPage}}{{/if}}</span><button type="button" data-action="item" data-item-id="{{id}}">{{dawnLabel 'openItem'}}</button>{{#if editing}}<button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</div></div></details>{{/each}}</section>{{else}}<div class="dawn-empty-block"><p>{{dawnLabel 'emptyTechniques'}}</p><button type="button" data-action="catalog" data-filter="technique">{{dawnLabel 'chooseTechniques'}}</button></div>{{/each}}

{{/if}}{{#if showSettings}}<h2>{{dawnLabel 'sheetSettings'}}</h2><label>{{dawnLabel 'notes'}}<textarea name="system.notes" rows="7">{{system.notes}}</textarea></label>
<details class="dawn-settings-section" data-expand="buildChecks"><summary>{{dawnLabel 'builder'}} · {{dawnLabel 'validationTitle'}}</summary><ul class="dawn-validation">{{#each validation}}<li>{{this}}</li>{{else}}<li>{{#if isReady}}{{dawnLabel 'ready'}}{{else}}{{dawnLabel 'validationPassed'}}{{/if}}</li>{{/each}}</ul>{{#if editing}}<label class="dawn-check"><input type="checkbox" name="system.build.standard" {{checked system.build.standard}}>{{dawnLabel 'standardBuild'}}</label><div class="dawn-buttons"><button type="button" data-action="initialArray">4 / 3 / 2 / 2</button>{{#if isDraft}}<button type="button" data-action="finalize">{{dawnLabel 'finalize'}}</button>{{/if}}</div>{{/if}}</details>
<details class="dawn-settings-section" data-expand="manualStatistics"><summary>{{dawnLabel 'manualStatistics'}}</summary><p class="dawn-muted">{{dawnLabel 'manualStatisticsHint'}}</p><div class="dawn-manual-grid">{{#each manualRows}}<label>{{label}}<input name="system.manualStatistics.{{key}}" type="number" min="0" value="{{value}}" placeholder="—" {{#unless ../editing}}disabled{{/unless}}></label>{{/each}}</div></details>
{{#if editing}}{{#if archivedItems}}<details class="dawn-settings-section" data-expand="removedItems"><summary>{{dawnLabel 'removedItems'}}</summary>{{#each archivedItems}}<p>{{name}} <button type="button" data-action="restore" data-item-id="{{id}}">{{dawnLabel 'restoreItem'}}</button></p>{{/each}}</details>{{/if}}{{/if}}<details class="dawn-settings-section" data-expand="equipment"><summary>{{dawnLabel 'otherFeaturesLabel'}}</summary>{{#each otherFeatures}}<details class="dawn-feature draggable" data-item-id="{{id}}" draggable="true"><summary>{{name}}</summary><p class="dawn-pre">{{{dawnRich description}}}</p><button type="button" data-action="item" data-item-id="{{id}}">{{dawnLabel 'openItem'}}</button>{{#if editing}}<button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</details>{{else}}<p class="dawn-empty">{{dawnLabel 'noEntries'}}</p>{{/each}}</details><p class="dawn-muted">{{dawnLabel 'tokenArtHint'}}</p>{{/if}}</div></section>
