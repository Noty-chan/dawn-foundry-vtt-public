<section class="dawn-sheet dawn-creation-body"><div class="dawn-kicker">DAWN · LIONWING</div><h2>{{dawnLabel 'createCharacter'}}</h2>
<nav class="dawn-creation-steps">{{#each steps}}<button type="button" data-action="step" data-step="{{index}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</nav>
<div class="dawn-budget-strip"><span>{{dawnLabel 'characterRanks'}} <b>{{budget.ranks}} / 8</b></span><span>{{dawnLabel 'skill'}} <b>{{budget.skillRanks}} / 4+</b></span><span>{{dawnLabel 'techniqueLevels'}} <b>{{budget.techniqueLevels}} / 5</b></span><span>{{dawnLabel 'boon'}} <b>{{budget.boons}} / 2</b></span></div>
{{#if locked}}<p>{{dawnLabel 'unlockToChange'}}</p>{{/if}}
<fieldset {{#if locked}}disabled{{/if}}>
{{#if concept}}<h3>{{dawnLabel 'creationSteps.concept'}}</h3><label>{{dawnLabel 'name'}}<input name="heroName" value="{{actor.name}}"></label><label>{{dawnLabel 'description'}}<textarea name="biography" rows="7">{{system.biography}}</textarea></label><p class="dawn-muted">{{dawnLabel 'creationArtHint'}}</p>{{/if}}
{{#if attributesStep}}<h3>{{dawnLabel 'attributes'}}</h3><p>{{dawnLabel 'attributeArrayHint'}}</p><div class="dawn-overview-attributes">{{#each attributes}}<label>{{label}}<input name="{{key}}" type="number" min="2" max="4" value="{{value}}"></label>{{/each}}</div>{{/if}}
{{#if featuresStep}}<h3>{{dawnLabel 'sourceGroups.skill'}}</h3><p class="dawn-muted">{{dawnLabel 'rankBudgetHint'}}</p><div class="dawn-creation-skills">{{#each skills}}<label><span>{{name}} <small>{{attribute}}</small></span><select name="{{id}}">{{#each ranks}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}</option>{{/each}}</select></label>{{/each}}</div><div class="dawn-blockhead"><h3>{{dawnLabel 'customSkills'}}</h3><p class="dawn-muted">{{dawnLabel 'customSkillsHint'}}</p><button type="button" data-action="addSkill">{{dawnLabel 'addCustomSkill'}}</button></div>{{#each customSkills}}<div class="dawn-feature" data-custom-skill="{{id}}"><label>{{dawnLabel 'name'}}<input data-custom-name value="{{name}}"></label><label>{{dawnLabel 'description'}}<textarea data-custom-description rows="2">{{description}}</textarea></label><label>{{dawnLabel 'skillAttribute'}}<select data-custom-attribute><option value="">{{dawnLabel 'skillAttributeUnset'}}</option>{{selectOptions attributeOptions selected=attribute}}</select></label><label>{{dawnLabel 'rank'}}<input data-custom-rank type="number" min="1" max="3" value="{{rank}}"></label><button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button></div>{{/each}}<div class="dawn-ability-builder"><h3>{{dawnLabel 'ability'}}</h3><p class="dawn-muted">{{dawnLabel 'abilityBuilderHint'}}</p>{{#if ability}}<button type="button" data-action="archive" data-item-id="{{ability.id}}">{{dawnLabel 'removeFromSheet'}}</button><p class="dawn-pre">{{{dawnRich ability.description}}}</p><p class="dawn-muted">{{dawnLabel 'rank'}} {{ability.rank}} · {{dawnLabel 'purchaseCost'}} {{ability.cost}} · {{dawnLabel 'totalCost'}} {{ability.totalCost}}</p>{{/if}}<div class="dawn-ability-words">{{#each wordGroups}}<label>{{label}}<select data-word="{{kind}}"><option value="">—</option>{{#each rows}}<option value="{{id}}" {{#if selected}}selected{{/if}} >{{name}} ({{cost}}) {{marks}}</option>{{/each}}</select></label>{{/each}}<label>{{dawnLabel 'rank'}}<input type="number" name="abilityRank" min="1" max="3" value="{{#if ability}}{{ability.rank}}{{else}}1{{/if}}"></label></div><details class="dawn-ability-special"><summary>{{dawnLabel 'abilityMarks'}}</summary><p class="dawn-muted">{{dawnLabel 'abilityMarksHint'}}</p><label class="dawn-check"><input name="freeCondition" type="checkbox" {{checked freeCondition}}>{{dawnLabel 'freeCondition'}}</label><label class="dawn-check"><input name="freeSelectedCondition" type="checkbox" {{checked freeSelectedCondition}}>{{dawnLabel 'freeSelectedCondition'}}</label><label>{{dawnLabel 'freeConditionText'}}<input name="freeConditionText" value="{{freeConditionText}}"></label><p class="dawn-muted">{{dawnLabel 'freeConditionHint'}}</p><label>{{dawnLabel 'specializeNoun'}}<input name="specialization" value="{{specialization}}"></label><label>{{dawnLabel 'extraNoun'}}<select name="extraNoun"><option value="">—</option>{{#each extraNouns}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}} ({{cost}})</option>{{/each}}</select></label></details><button type="button" data-action="ability">{{dawnLabel 'saveAbility'}}</button></div>{{/if}}
{{#if outlookStep}}<h3>{{dawnLabel 'outlookAndBoons'}}</h3><label>{{dawnLabel 'primaryOutlook'}}<select name="outlook"><option value="">—</option>{{#each outlooks}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><p class="dawn-muted">{{dawnLabel 'creationBoonsHint'}}</p><button type="button" data-action="catalog">{{dawnLabel 'chooseBoons'}}</button>{{#each boons}}<details class="dawn-feature"><summary>{{name}}{{#if inherent}} · {{dawnLabel 'inherentBoon'}}{{/if}}</summary><p class="dawn-pre">{{{dawnRich description}}}</p><button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button></details>{{/each}}{{/if}}
{{#if techniquesStep}}<h3>{{dawnLabel 'techniques'}}</h3><p>{{dawnLabel 'creationTechniquesHint'}}</p><button type="button" data-action="catalog">{{dawnLabel 'chooseTechniques'}}</button>{{#each techniques}}<p>{{name}} · {{dawnLabel 'level'}} {{level}} / 3 <button type="button" data-action="archive" data-item-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button></p>{{/each}}{{/if}}
{{#if review}}<h3>{{dawnLabel 'validationTitle'}}</h3><ul class="dawn-validation">{{#each errors}}<li>{{this}}</li>{{else}}<li>{{dawnLabel 'validationPassed'}}</li>{{/each}}</ul><p class="dawn-muted">{{dawnLabel 'creationFinishHint'}}</p>{{/if}}
{{#if archivedItems}}<details><summary>{{dawnLabel 'removedItems'}}</summary>{{#each archivedItems}}<p>{{name}} <button type="button" data-action="restore" data-item-id="{{id}}">{{dawnLabel 'restoreItem'}}</button></p>{{/each}}</details>{{/if}}</fieldset><footer class="dawn-creation-footer"><button type="button" data-action="sheet">{{dawnLabel 'openSheet'}}</button><button type="button" data-action="save" {{#if locked}}disabled{{/if}}>{{dawnLabel 'save'}}</button><span></span>{{#unless first}}<button type="button" data-action="previous">{{dawnLabel 'previous'}}</button>{{/unless}}{{#if last}}<button class="dawn-primary" type="button" data-action="finish" {{#unless canFinish}}disabled{{/unless}} {{#if locked}}disabled{{/if}}>{{dawnLabel 'finalize'}}</button>{{else}}<button class="dawn-primary" type="button" data-action="next" {{#if locked}}disabled{{/if}}>{{dawnLabel 'next'}}</button>{{/if}}</footer></section>
