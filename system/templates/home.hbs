<section class="dawn-sheet"><div class="dawn-kicker">DAWN · LIONWING · {{version}}</div><h2>{{dawnLabel 'welcome'}}</h2><p>{{dawnLabel 'welcomeText'}}</p>
<div class="dawn-buttons"><button type="button" data-action="hero" {{#unless canCreateHero}}disabled{{/unless}}>{{dawnLabel 'newHero'}}</button><button type="button" data-action="npc" {{#unless gm}}disabled{{/unless}}>{{dawnLabel 'bookEnemies'}}</button>{{#if gm}}<button type="button" data-action="compound">{{dawnLabel 'compoundCreate'}}</button><button type="button" data-action="fodder">{{dawnLabel 'fodderButton'}}</button><button type="button" data-action="fodderBatch">{{dawnLabel 'fodderBatchTitle'}}</button>{{/if}}<button type="button" data-action="catalog">{{dawnLabel 'characterLibrary'}}</button>{{#if gm}}<button type="button" data-action="narratorCatalog">{{dawnLabel 'narratorLibrary'}}</button>{{/if}}<button type="button" data-action="party">{{dawnLabel 'party'}}</button><button type="button" data-action="battle">{{dawnLabel 'battleTitle'}}</button></div>
{{#if gm}}<button type="button" data-action="gmControls">{{dawnLabel 'tableRolls'}}</button><div class="dawn-buttons"><button type="button" data-action="createBoard">{{dawnLabel 'boardCreate'}}</button><button type="button" data-action="discardToken">{{dawnLabel 'boardDiscard'}}</button></div><p class="dawn-muted">{{dawnLabel 'boardHint'}}</p>{{/if}}<p>{{dawnEntryCount counts}}</p><p class="dawn-muted">{{dawnLabel 'developmentNotice'}}</p>
{{#if testWorld}}<hr><button type="button" data-action="prepareTestActors">{{dawnLabel 'testSetupButton'}}</button><p class="dawn-muted">{{dawnLabel 'testSetupHint'}}</p><button type="button" data-action="importTestHeroes">{{dawnLabel 'testHeroImport'}}</button><button type="button" data-action="test">{{dawnLabel 'runtimeChecks'}}</button><button type="button" data-action="coreTest">{{dawnLabel 'coreChecks'}}</button>{{/if}}</section>
