<section class="dawn-roll-workspace">
<label>{{dawnLabel 'difficulty'}}<select data-default-field="difficulty">{{selectOptions difficultyOptions selected=difficulty}}</select></label>
{{#if fixed}}<div class="dawn-target"><select data-default-field="comparison" aria-label="{{dawnLabel 'comparison'}}">{{selectOptions (dawnComparisons) selected=comparison}}</select><input type="number" data-default-field="target" value="{{target}}" min="0" max="200" aria-label="{{dawnLabel 'targetHits'}}"></div>{{/if}}
<div class="dawn-modifiers"><div class="dawn-modifier"><span>{{dawnLabel 'advantage'}}</span><div><button type="button" data-action="adjust" data-field="advantage" data-delta="-1" aria-label="{{dawnLabel 'lessAdvantage'}}">−</button><strong>{{advantage}}</strong><button type="button" data-action="adjust" data-field="advantage" data-delta="1" aria-label="{{dawnLabel 'moreAdvantage'}}">+</button></div></div><div class="dawn-modifier"><span>{{dawnLabel 'disadvantage'}}</span><div><button type="button" data-action="adjust" data-field="disadvantage" data-delta="-1" aria-label="{{dawnLabel 'lessDisadvantage'}}">−</button><strong>{{disadvantage}}</strong><button type="button" data-action="adjust" data-field="disadvantage" data-delta="1" aria-label="{{dawnLabel 'moreDisadvantage'}}">+</button></div></div></div>
<p class="dawn-muted">{{dawnLabel 'tableDefaultsHint'}}</p><button type="button" data-action="reset">{{dawnLabel 'reset'}}</button>
</section>