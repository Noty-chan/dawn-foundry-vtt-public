<section class="dawn-sheet"><header class="dawn-heading"><img src="{{item.img}}" alt="" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}><div class="dawn-identity"><div class="dawn-kicker">DAWN · {{dawnLabel item.type}}</div><h2>{{text.name}}</h2></div></header>
{{#if isTechnique}}<p class="dawn-muted">{{technique.tags}}</p><p class="dawn-flavor">{{{dawnRich technique.description}}}</p><div class="dawn-section-title"><h3>{{dawnLabel 'learnedLevel'}}</h3><span class="dawn-pips">{{#each technique.levels}}<button type="button" data-action="level" data-level="{{n}}" aria-pressed="{{learned}}" {{#unless ../editable}}disabled{{/unless}}>{{n}}</button>{{/each}}</span></div>{{#each technique.levels}}<section class="dawn-tech-level {{#if learned}}learned{{/if}}"><h3>{{n}}. {{name}}</h3><p class="dawn-pre">{{{dawnRich text}}}</p></section>{{/each}}
{{#if editable}}<details class="dawn-formula" data-technique-editor data-language="{{editorLanguage}}" {{#if definitionOpen}}open{{/if}}><summary>{{dawnLabel 'editTechniqueDefinition'}}</summary><p class="dawn-muted">{{dawnLabel 'techniqueLanguageHint'}} {{editorLanguage}}</p><label>{{dawnLabel 'name'}}<input data-definition-field="name" value="{{definition.name}}"></label><div class="dawn-form-row"><label>{{dawnLabel 'archetype'}}<select data-definition-field="archetype"><option value="">—</option>{{#each archetypeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><label>{{dawnLabel 'complexity'}}<input data-definition-field="complexity" type="number" min="1" value="{{system.complexity}}"></label></div><label>{{dawnLabel 'techniqueTags'}}<input data-definition-field="tags" value="{{definition.tags}}"></label><label>{{dawnLabel 'techniqueFlavor'}}<textarea data-definition-field="flavor" rows="3">{{definition.description}}</textarea></label>{{#each definition.levels}}<section class="dawn-tech-level"><h3>{{dawnLabel 'level'}} {{n}}</h3><label>{{dawnLabel 'name'}}<input data-level="{{n}}" data-level-field="name" value="{{name}}"></label><label>{{dawnLabel 'description'}}<textarea data-level="{{n}}" data-level-field="text" rows="4">{{text}}</textarea></label></section>{{/each}}<button type="button" data-action="saveTechnique">{{dawnLabel 'saveTechniqueDefinition'}}</button></details>{{/if}}
{{else}}<fieldset {{#unless editable}}disabled{{/unless}}>{{#unless hasContent}}<label>{{dawnLabel 'name'}}<input name="name" value="{{item.name}}"></label>{{/unless}}{{#if isRanked}}<div class="dawn-form-row"><label>{{dawnLabel 'rank'}}<input name="system.rank" type="number" min="1" max="3" value="{{system.rank}}"></label><label>{{dawnLabel 'purchaseCost'}}<input name="system.purchaseCost" type="number" min="0" value="{{system.purchaseCost}}"></label></div>{{/if}}<p class="dawn-pre">{{{dawnRich text.description}}}</p></fieldset>{{/if}}
<fieldset {{#unless editable}}disabled{{/unless}}><label>{{dawnLabel 'notes'}}<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label><details><summary>{{dawnLabel 'overrides'}}</summary>{{#if hasContent}}<label>{{dawnLabel 'storedName'}}<input name="name" value="{{item.name}}"></label>{{/if}}<label>{{dawnLabel 'name'}}<input name="system.overrides.name" value="{{system.overrides.name}}"></label><label>{{dawnLabel 'description'}}<textarea name="system.overrides.description" rows="5">{{system.overrides.description}}</textarea></label></details></fieldset>
{{#if legacyNotes}}<details class="dawn-formula"><summary>{{dawnLabel 'legacyNotes'}}</summary>{{#each legacyNotes}}<p>{{level}}. {{name}}</p><p class="dawn-pre">{{{dawnRich notes}}}</p>{{/each}}</details>{{/if}}
<div class="dawn-tech-footer"><span>{{#if packLabel}}{{packLabel}}{{/if}}{{#if source.pdfPage}} PDF {{source.pdfPage}}{{/if}}</span><button type="button" data-action="show">{{dawnLabel 'showChat'}}</button></div></section>
