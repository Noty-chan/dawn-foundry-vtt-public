<section class="dawn-sheet dawn-core-sheet">
<header class="dawn-heading">
<img src="{{actor.img}}" data-action="editImage" data-edit="img" alt="{{name}}">
<div class="dawn-identity"><div class="dawn-kicker">DAWN · LIONWING</div>{{#if editing}}<input class="dawn-name" aria-label="{{dawnLabel 'name'}}" name="name" value="{{actor.name}}">{{else}}<h1>{{name}}</h1>{{/if}}<div class="dawn-subtitle">{{dawnLabel actor.type}}</div></div>
<div class="dawn-heading-tools">{{#if editable}}<button type="button" class="dawn-edit-toggle" data-action="editing" aria-pressed="{{editing}}">{{#if editing}}{{dawnLabel 'finishEditing'}}{{else}}{{dawnLabel 'configureSheet'}}{{/if}}</button>{{/if}}</div>
</header>
<fieldset {{#unless editable}}disabled{{/unless}}>
{{#if compoundParts}}<details class="dawn-settings-section"><summary>{{dawnLabel 'compoundName'}} · {{dawnLabel 'compoundGate'}}: {{compoundGate}}</summary>
<p class="dawn-muted">{{dawnLabel 'compoundManual'}}</p>
{{#each compoundParts}}<p><strong>{{name}}</strong> {{{dawnRich passive}}}</p>{{/each}}</details>{{/if}}
{{#if isNpc}}<div class="dawn-resources dawn-npc-resources"><label class="dawn-resource dawn-health"><span>{{dawnLabel 'health'}}</span><div><input aria-label="{{dawnLabel 'health'}}" name="system.health.value" type="number" min="0" value="{{system.health.value}}"><span class="dawn-resource-max">/ {{system.health.max}}</span></div></label><label class="dawn-resource"><span>{{dawnLabel 'evasion'}}</span><input name="system.evasion.value" type="number" min="0" value="{{system.evasion.value}}"></label><div class="dawn-resource"><span>{{dawnLabel 'speed'}}</span><strong>{{system.speed}}</strong></div><div class="dawn-resource"><span>{{dawnLabel 'armor'}}</span><strong>{{system.armor}}</strong></div></div><div class="dawn-statline"><label class="dawn-npc-tier">{{dawnLabel 'tier'}}<input type="number" name="system.tier" value="{{system.tier}}" min="0"></label>{{#if isPreset}}<span>{{dawnLabel 'bookPreset'}}</span>{{/if}}{{#if combatant}}<label>{{dawnLabel 'ap'}} {{#if isGM}}<input data-combat-ap type="number" min="0" value="{{ap}}" aria-label="{{dawnLabel 'apCorrection'}}">{{else}}<strong>{{ap}}</strong>{{/if}}</label>{{/if}}</div>{{/if}}
{{#if system.speedEffectConflict}}<p class="dawn-context-hint">{{dawnLabel 'speedEffectConflict'}}</p>{{/if}}<nav class="dawn-tabs">{{#each tabs}}<button type="button" data-action="sheetTab" data-tab="{{id}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</nav>
{{#if showSheet}}{{#if isNpc}}{{#if isGM}}{{#unless compoundParts}}<button type="button" data-action="damage">{{dawnLabel 'damageTitle'}}</button>{{/unless}}{{/if}}{{#if isGM}}{{#if damageLog}}<details class="dawn-settings-section"><summary>{{dawnLabel 'damageHistory'}}</summary>{{#each damageLog}}<p>{{id}} · {{kind}}: {{amount}} · {{dawnLabel 'health'}} {{health}} · {{dawnLabel 'evasion'}} {{evasion}}</p>{{/each}}</details>{{/if}}{{/if}}{{#if activeEffects}}<section class="dawn-settings-section"><h3>{{dawnLabel 'activeEffects'}}</h3>{{#each activeEffects}}<details><summary>{{name}} {{#if durationStale}}<small>{{dawnLabel 'effectDurationManualShort'}}</small>{{else}}{{#if manual}}<small>{{dawnLabel 'effectManualShort'}}</small>{{/if}}{{/if}}</summary>{{#if description}}<p class="dawn-pre">{{{dawnRich description}}}</p>{{/if}}{{#if durationStale}}<p class="dawn-muted">{{dawnLabel 'effectDurationStale'}}</p>{{/if}}{{#if canSetDuration}}<button type="button" data-action="effectDuration" data-effect-id="{{id}}" aria-pressed="{{autoDuration}}">{{#if durationStale}}{{dawnLabel 'effectDurationClearStale'}}{{else}}{{#if autoDuration}}{{dawnLabel 'effectDurationAuto'}}{{else}}{{dawnLabel 'effectDurationEnable'}}{{/if}}{{/if}}</button><p class="dawn-muted">{{dawnLabel 'effectDurationHint'}}</p>{{/if}}{{#if ../editable}}<button type="button" data-action="removeEffect" data-effect-id="{{id}}">{{dawnLabel 'removeFromSheet'}}</button>{{/if}}</details>{{/each}}</section>{{/if}}{{/if}}
{{#if isNpc}}{{#if isFodder}}<p class="dawn-pre">{{{dawnRich fodderDescription}}}</p>{{else}}{{#unless isPreset}}{{#unless compoundParts}}<p>{{dawnLabel 'chooseBookEnemy'}}</p><button type="button" data-action="catalog" data-filter="npc">{{dawnLabel 'bookEnemies'}}</button>{{/unless}}{{/unless}}<h2>{{dawnLabel 'passive'}}</h2><p class="dawn-pre">{{{dawnRich passive}}}</p><div class="dawn-buttons"><button type="button" class="dawn-primary" data-action="roll">{{dawnLabel 'roll'}}</button></div><h2>{{dawnLabel 'actions'}}</h2><p class="dawn-muted">{{dawnLabel 'npcActionManualHint'}}</p>{{#if isGM}}{{#if combatant}}<button type="button" data-action="npcStride">{{dawnLabel 'npcStride'}}</button>{{/if}}{{/if}}{{#each otherFeatures}}<details class="dawn-feature draggable" data-expand="npc-action-{{id}}" data-item-id="{{id}}" draggable="true"><summary>{{name}}{{#if npcIsAce}} <small>{{dawnLabel 'npcAce'}}{{#if npcHasAceThreshold}} · {{dawnLabel 'npcAceThreshold'}} {{npcAceThreshold}}{{/if}}</small>{{/if}}{{#if npcHasCost}} <small>{{npcCost}} {{dawnLabel 'ap'}}</small>{{/if}}</summary><p class="dawn-pre">{{{dawnRich description}}}</p>{{#if npcIsAce}}{{#if npcAceTensionStatus}}<p>{{dawnLabel npcAceTensionStatus}}</p>{{/if}}<p class="dawn-muted">{{dawnLabel 'npcAceManualHint'}}</p>{{/if}}{{#if isNpcAction}}{{#if ../isGM}}{{#if npcHasCost}}{{#unless npcIsAce}}<button type="button" data-action="npcActionSpend" data-item-id="{{id}}">{{dawnLabel 'npcActionSpend'}}</button>{{/unless}}{{/if}}{{/if}}<button type="button" data-action="npcActionRoll" data-item-id="{{id}}">{{dawnLabel 'rollAction'}}</button><button type="button" data-action="npcActionChat" data-item-id="{{id}}">{{dawnLabel 'showChat'}}</button>{{/if}}<button type="button" data-action="item" data-item-id="{{id}}">{{dawnLabel 'openItem'}}</button></details>{{/each}}{{/if}}{{/if}}
{{#if isParty}}<h2>{{dawnLabel 'influence'}}</h2>{{#each accounts}}<label>{{name}}<input type="number" min="0" name="system.participants.{{id}}.influence" value="{{influence}}"></label>{{else}}<p>{{dawnLabel 'partyEmpty'}}</p>{{/each}}{{#if isGM}}<button type="button" data-action="partyAccount">{{dawnLabel 'partyAccountCreate'}}</button>{{/if}}{{/if}}
{{#if isController}}<label>{{dawnLabel 'host'}}<input name="system.hostUuid" value="{{system.hostUuid}}"></label>{{/if}}
{{/if}}
{{#if showBuilder}}{{#if isNpc}}<p class="dawn-muted">{{dawnLabel 'npcFormulaHint'}}</p>{{#each statisticRows}}<h3>{{label}}</h3><div class="dawn-form-row"><label>{{dawnLabel 'baseValue'}}<input type="number" min="0" name="system.statistics.{{key}}.base" value="{{base}}"></label><label>{{dawnLabel 'perTier'}}<input type="number" min="0" name="system.statistics.{{key}}.perTier" value="{{perTier}}"></label><label>{{dawnLabel 'fixedValue'}}<input type="number" min="0" name="system.statistics.{{key}}.override" value="{{override}}" placeholder="—"></label></div>{{/each}}{{/if}}{{/if}}
{{#if showNotes}}<label>{{dawnLabel 'notes'}}<textarea name="system.notes" rows="16">{{system.notes}}</textarea></label>{{/if}}
</fieldset></section>
